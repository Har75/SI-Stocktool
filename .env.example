# Local development and local Docker only.
# Do not bake a real key into an image, fly.toml, or a public host.
# ALPHA_VANTAGE_API_KEY=

# Comma-separated browser origins allowed to call the API.
# Leave empty for same-origin only. Credentialed browser calls stay same-origin.
# ALLOWED_ORIGIN=https://your-frontend.example

PORT=4721
NODE_ENV=development

# JSON accounts, sessions, and watchlists. One process only.
# DATA_DIR=data

# Admin is the account with this email. Set the password before the first boot
# so the account exists before anyone else can sign up with it.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Session lifetime in hours. Default is 14 days. Cookie is HTTP-only and SameSite=Lax.
# Secure is on when NODE_ENV=production. Set COOKIE_SECURE=0 only for a private local HTTP drill.
# SESSION_TTL_HOURS=336
# BCRYPT_COST=12

# Stripe test mode. Use sk_test_ and a test price. Never commit the filled-in file.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID=
# PUBLIC_BASE_URL=http://127.0.0.1:4721

# Optional overrides (requests per minute).
# RATE_LIMIT_SEARCH=60
# RATE_LIMIT_QUOTES=30
# RATE_LIMIT_ANALYZE=10
# RATE_LIMIT_TEST_CONNECTION=10
# RATE_LIMIT_SIGNUP=5
# RATE_LIMIT_LOGIN=10
# RATE_LIMIT_WATCHLIST=30
# RATE_LIMIT_REANALYZE=10
# RATE_LIMIT_ADMIN=30
# RATE_LIMIT_BILLING=10
# RATE_LIMIT_WEBHOOK=120
